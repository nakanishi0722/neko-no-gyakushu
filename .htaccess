# 存在しないページを開いたときに 404.html を表示する（Apache・エックスサーバー等）
ErrorDocument 404 /404.html

# 文字化け防止
AddDefaultCharset UTF-8

# 画像・CSS をブラウザに一定期間保存して表示を速くする（JS＝キャスト・お知らせのデータは毎回最新を確認）
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>

# 文字データを圧縮して転送量を減らす
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>
